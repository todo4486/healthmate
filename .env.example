# HealthMate needs no secrets. These optional settings are read from the
# environment (set them in your hosting dashboard, or export them locally).

# "development" locally, "production" on the live server.
# Production turns on HTTPS-only (HSTS) headers and trusts the host's proxy.
APP_ENV=development

# How much to log: DEBUG, INFO (default) or WARNING.
LOG_LEVEL=INFO

# Set automatically by most hosting platforms; only needed for gunicorn locally.
# PORT=8000
